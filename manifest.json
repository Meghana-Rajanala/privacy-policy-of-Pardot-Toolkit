{
  "manifest_version": 3,
  "name": "Pardot Toolkit (TEST build)",
  "version": "1.0.0",
  "description": "Account Engagement helper: edit form handler fields, batch updates from CSV, and quick search.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pardot Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.pardot.com/*",
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pardot.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pardot.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "confirm-main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}